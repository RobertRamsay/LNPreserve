diff --git a/LNPreserve/scripts/ln_ai_region/ln_ai_region.gml b/LNPreserve/scripts/ln_ai_region/ln_ai_region.gml
new file mode 100644
index 00000000..d6775ca2
--- /dev/null
+++ b/LNPreserve/scripts/ln_ai_region/ln_ai_region.gml
@@ -0,0 +1,33 @@
+/// Where LNPreserve's game picture sits on the 1920x1080 canvas: [x, y, w, h].
+/// Used by obj_ai_restyle so only the play area is restyled; HUD panels and text stay crisp.
+/// A width of 0 means "show the normal game" (startup, workbench, menus, editors, viewers).
+function ln_ai_region() {
+    var _none = [0, 0, 0, 0];
+    var _host = instance_find(obj_ln_preserve, 0);
+    if (_host == noone) {
+        return _none;
+    }
+    if (!global.ln_tool.active) {
+        return _none;
+    }
+    if (_host.startup_active) {
+        return _none;
+    }
+    if (global.ln_editor.open || global.ln_sprites.open || global.ln_tracks.open) {
+        return _none;
+    }
+    var _region = ln_crt_game_region(_host);
+    if (!is_array(_region)) {
+        return _none;
+    }
+    var _rect = [_region[0], _region[1], _region[2] - _region[0], _region[3] - _region[1]];
+
+    // UI visible: the 1280x800 tool surface is drawn at 320,140
+    if (ln_tool_ui_visible()) {
+        return [320 + _rect[0], 140 + _rect[1], _rect[2], _rect[3]];
+    }
+
+    // UI hidden: the picture is scaled and centred (see ln_game_view)
+    var _view = ln_game_view(_host, _rect);
+    return [_view[0], _view[1], _view[2], _view[3]];
+}
